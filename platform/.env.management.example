# Environment variables for Mod.ManagementApi (ca-mgmt)
# See contracts/environment/management.md and contracts/environment/common.md
# Copy to .env.management.local and fill in values for local development.
# Never commit real values.

# common.md
AZURE_CLIENT_ID=
APPLICATIONINSIGHTS_CONNECTION_STRING=
ASPNETCORE_URLS=http://+:8080
MOD_ENVIRONMENT=
SQL_CONNECTION=

# management.md
KEYVAULT_URI=
CA_CERT_NAME=collector-ca
CERT_VALIDITY_DAYS=7
CMD_SB_FQDN=
CMD_SB_SAS_KEY_NAME=collector-issuer
CMD_SB_SAS_KEY=
INGEST_URL=
MANAGEMENT_URL=
COMMAND_TOKEN_LIFETIME_MINUTES=60

# Local development only (not deployed to Azure)
CA_PFX_PATH=
