# Environment variables for Mod.IngestApi (ca-ingest)
# See contracts/environment/ingest.md and contracts/environment/common.md
# Copy to .env.ingest.local and fill in values for local development.
# Never commit real values.

# common.md
AZURE_CLIENT_ID=
APPLICATIONINSIGHTS_CONNECTION_STRING=
ASPNETCORE_URLS=http://+:8080
MOD_ENVIRONMENT=
SQL_CONNECTION=

# ingest.md
EVENTHUB_FQDN=
EVENTHUB_NAME=
COLLECTOR_CA_CERT_PEM_BASE64=
INGEST_MAX_EVENTS=
INGEST_MAX_BYTES=
INGEST_RATE_LIMIT_PER_COLLECTOR=
REGISTRY_CACHE_SECONDS=
