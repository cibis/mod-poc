# Environment variables for ca-portal (portal-api).
# Copy to .env.local and fill in values for local development.
# NEVER commit .env.local or any file containing real secrets.

# --- common (all production-space .NET services) ---
AZURE_CLIENT_ID=
APPLICATIONINSIGHTS_CONNECTION_STRING=
ASPNETCORE_URLS=http://+:8080
MOD_ENVIRONMENT=
SQL_CONNECTION=

# --- portal-specific ---
KEYVAULT_URI=
PORTAL_JWT_KEY=
CMD_SB_FQDN=
SIM_SB_FQDN=
SIM_SB_SAS_KEY_NAME=sim-issuer
SIM_SB_SAS_KEY=
EVENTHUB_FQDN=
EVENTHUB_NAME=
EVENTHUB_CONSUMER_GROUP=processing
CHECKPOINT_BLOB_CONTAINER_URL=
PRODUCTION_SUBSCRIPTION_ID=
PRODUCTION_RESOURCE_GROUP=
INGEST_APP_NAME=ca-ingest
PROCESSING_APP_NAME=ca-processing
MANAGEMENT_APP_NAME=ca-mgmt
PORTAL_APP_NAME=ca-portal
REPORTING_APP_NAME=ca-reporting
CONTROLLER_SUBSCRIPTION_ID=
CONTROLLER_RESOURCE_GROUP=
CONTROLLER_ENVIRONMENT_ID=
CONTROLLER_LOCATION=northeurope
COLLECTOR_IMAGE=
COLLECTOR_PULL_IDENTITY_ID=
MANAGEMENT_URL=
