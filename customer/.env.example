# Environment variables for ca-reporting (customer module)
# Copy to .env.local and fill in values. Never commit .env.local.
# Production values are injected by infra (Bicep) or Key Vault.

# Common (contracts/environment/common.md)
AZURE_CLIENT_ID=
APPLICATIONINSIGHTS_CONNECTION_STRING=
ASPNETCORE_URLS=http://+:8080
MOD_ENVIRONMENT=
SQL_CONNECTION=

# Reporting-specific (contracts/environment/reporting.md)
REPORTING_JWT_KEY=
FRESHNESS_STALE_SECONDS=60
LIVE_POLL_SECONDS=2
