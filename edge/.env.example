# edge collector environment variables (contracts/environment/collector.md)
# Copy to .env.local and fill in values for local development.
# Never commit .env.local or any file containing real secrets.

COLLECTOR_ID=
MANAGEMENT_URL=
ENROLMENT_TOKEN=
DATA_DIR=/data
SIM_SB_FQDN=
SIM_COMMAND_QUEUE=sim/
SIM_SB_KEY_NAME=sim-issuer
SIM_SB_KEY=
SIM_STATUS_QUEUE=sim-status
SIM_INITIAL_RATE=1
COLLECTOR_SOFTWARE_VERSION=dev
LOG_LEVEL=Information

# Development only — accept self-signed TLS certificates from local platform APIs
LOCAL_INSECURE_TLS=true

# Optional — export telemetry to Azure Monitor (omit to disable)
# APPLICATIONINSIGHTS_CONNECTION_STRING=
